spring:
  application:
    name: config-server
  cloud:
    config:
      server:
        git:
          uri: https://github.com/Nikhilyadav0001/smart-healthcare-config.git
          default-label: main
          username: Nikhilyadav0001
          password: ${CONFIG_GIT_TOKEN}
          force-pull: true
  security:
    user:
      name: config
      password: ${CONFIG_SERVER_PASSWORD:dev-config-pass}

server:
  port: 8888
  shutdown: graceful

management:
  endpoints:
    web:
      exposure:
        include: health,info
  endpoint:
    health:
      probes:
        enabled: true
