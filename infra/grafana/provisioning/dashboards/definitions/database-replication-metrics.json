    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Database Replication Lag & Replica Member Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "axisCenteredZero": false, "axisLabel": "Bytes", "drawStyle": "line", "lineInterpolation": "linear" },
          "unit": "decbytes"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "PostgreSQL Replication Lag (Bytes)",
      "type": "timeseries",
      "targets": [
        { "expr": "pg_stat_replication_bytes or (pg_stat_replication_reply_time * 0)", "legendFormat": "{{application_name}} lag", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "axisCenteredZero": false, "axisLabel": "Seconds", "drawStyle": "line", "lineInterpolation": "linear" },
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 30 }] }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "MariaDB Replication Delay (Seconds Behind Master)",
      "type": "timeseries",
      "targets": [
        { "expr": "mysql_slave_status_seconds_behind_master", "legendFormat": "MariaDB Replica Delay", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "axisCenteredZero": false, "axisLabel": "Seconds", "drawStyle": "line", "lineInterpolation": "linear" },
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 2 }, { "color": "red", "value": 10 }] }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "MongoDB Replica Set Member Lag (Seconds)",
      "type": "timeseries",
      "targets": [
        { "expr": "mongodb_mongod_replset_member_replication_lag", "legendFormat": "Member {{member}} Lag", "refId": "A" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Active Connections & Resource Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "none"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 15 },
      "id": 7,
      "title": "PostgreSQL Active Backends / Connections",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(pg_stat_database_numbackends) by (datname)", "legendFormat": "{{datname}} connections", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "none"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 15 },
      "id": 8,
      "title": "MariaDB Connected Threads",
      "type": "timeseries",
      "targets": [
        { "expr": "mysql_global_status_threads_connected", "legendFormat": "Connected Threads", "refId": "A" }
      ]
    }
