    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "Bytes",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "linear",
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1048576 },
              { "color": "red", "value": 10485760 }
            ]
          },
          "unit": "decbytes"
