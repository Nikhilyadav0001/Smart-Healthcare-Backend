{
  "info": {
    "_postman_id": "smarthealth-e2e-collection-v1",
    "name": "Smart health care",
    "description": "Comprehensive test suite covering Service Template, User Profile Service, Auth Service (Basic, Bearer/JWT, API Key, Admin Key, OAuth2), Health Records, ML Predictions, Go Report Service, and DB Replication / Observability.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8080" },
    { "key": "authUrl", "value": "http://127.0.0.1:8081" },
    { "key": "adminUrl", "value": "http://127.0.0.1:9090" },
    { "key": "eurekaUrl", "value": "http://127.0.0.1:8761" },
    { "key": "goUrl", "value": "http://127.0.0.1:8086" },
    { "key": "mailpitUrl", "value": "http://127.0.0.1:8025" },
    { "key": "patientId", "value": "53ca9f82-1d10-4d0c-b6be-126092d7c169" },
    { "key": "predictionId", "value": "" },
    { "key": "jwtToken", "value": "" },
    { "key": "apiKey", "value": "smarthealth-dev-secret-api-key-2026" },
    { "key": "adminApiKey", "value": "smarthealth-admin-secret-key-2026" }
  ],
  "item": [
    {
      "name": "Service Template",
      "item": [
        {
          "name": "Service Template Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/service-template/ping", "host": ["{{baseUrl}}"], "path": ["service-template", "ping"] }
          }
        }
      ]
    },
    {
      "name": "user-profile-service",
      "item": [
        {
          "name": "Profile Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/users/ping", "host": ["{{baseUrl}}"], "path": ["api", "users", "ping"] }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Dev-User-Id", "value": "{{patientId}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Dev-User-Id", "value": "{{patientId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Dr. Alex Mercer\",\n  \"dateOfBirth\": \"1985-06-12\",\n  \"gender\": \"MALE\",\n  \"phone\": \"+1-555-0144\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] }
          }
        }
      ]
    },
    {
      "name": "auth service",
      "item": [
        {
          "name": "Register Patient Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('patientId', json.userId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient_{{$randomInt}}@smarthealth.local\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Public Demo (No Auth)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{authUrl}}/auth/demo/public", "host": ["{{authUrl}}"], "path": ["auth", "demo", "public"] }
          }
        },
        {
          "name": "HTTP Basic Auth Demo",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "nikhil.test@smarthealth.io", "type": "string" },
                { "key": "password", "value": "Password123!", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{authUrl}}/auth/demo/basic", "host": ["{{authUrl}}"], "path": ["auth", "demo", "basic"] }
          }
        },
        {
          "name": "API Key Auth Demo (Standard Key)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-KEY", "value": "{{apiKey}}" }
            ],
            "url": { "raw": "{{authUrl}}/auth/demo/api-key", "host": ["{{authUrl}}"], "path": ["auth", "demo", "api-key"] }
          }
        },
        {
          "name": "Admin Predefined API Key Demo",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-KEY", "value": "{{adminApiKey}}" }
            ],
            "url": { "raw": "{{authUrl}}/auth/demo/admin-api-key", "host": ["{{authUrl}}"], "path": ["auth", "demo", "admin-api-key"] }
          }
        },
        {
          "name": "OAuth2 Client Credentials (Token Exchange via Basic Auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('jwtToken', json.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "prediction-service", "type": "string" },
                { "key": "password", "value": "nikhil", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials", "type": "text" },
                { "key": "scope", "value": "prediction.read prediction.write", "type": "text" }
              ]
            },
            "url": { "raw": "{{authUrl}}/oauth2/token", "host": ["{{authUrl}}"], "path": ["oauth2", "token"] }
          }
        },
        {
          "name": "Bearer Token (JWT) Demo",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{jwtToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{authUrl}}/auth/demo/bearer-jwt", "host": ["{{authUrl}}"], "path": ["auth", "demo", "bearer-jwt"] }
          }
        },
        {
          "name": "Service-to-Service Communication Demo",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{jwtToken}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{authUrl}}/auth/demo/service-to-service", "host": ["{{authUrl}}"], "path": ["auth", "demo", "service-to-service"] }
          }
        },
        {
          "name": "OAuth 2.0 & OIDC Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{authUrl}}/auth/demo/oauth-info", "host": ["{{authUrl}}"], "path": ["auth", "demo", "oauth-info"] }
          }
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/me", "host": ["{{baseUrl}}"], "path": ["api", "me"] }
          }
        },
        {
          "name": "Dev Tokens",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/dev/tokens", "host": ["{{baseUrl}}"], "path": ["dev", "tokens"] }
          }
        }
      ]
    },
    {
      "name": "health-data-service",
      "item": [
        {
          "name": "Health Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health/ping", "host": ["{{baseUrl}}"], "path": ["api", "health", "ping"] }
          }
        },
        {
          "name": "Create Health Record",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Dev-User-Id", "value": "{{patientId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"ageYears\": 45,\n  \"sex\": \"MALE\",\n  \"heightCm\": 175.5,\n  \"weightKg\": 82.0,\n  \"bmi\": 26.6,\n  \"systolicBp\": 135,\n  \"diastolicBp\": 85,\n  \"fastingGlucoseMgDl\": 110.0,\n  \"hba1cPercent\": 6.1,\n  \"totalCholesterolMgDl\": 210.0,\n  \"hdlMgDl\": 48.0,\n  \"ldlMgDl\": 130.0,\n  \"smokingStatus\": \"NEVER\",\n  \"activityLevel\": \"MODERATE\",\n  \"hasHypertension\": true,\n  \"hasHeartDisease\": false,\n  \"familyHistoryDiabetes\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/health/records", "host": ["{{baseUrl}}"], "path": ["api", "health", "records"] }
          }
        },
        {
          "name": "Get Latest Record",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health/records/latest?patientId={{patientId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health", "records", "latest"],
              "query": [{ "key": "patientId", "value": "{{patientId}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "prediction-service",
      "item": [
        {
          "name": "Get Models",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/predictions/models", "host": ["{{baseUrl}}"], "path": ["api", "predictions", "models"] }
          }
        },
        {
          "name": "Predict All Diseases",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('predictionId', json.prediction_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": \"{{patientId}}\",\n  \"patient_name\": \"Alex Mercer\",\n  \"patient_email\": \"patient@smarthealth.local\",\n  \"features\": {\n    \"age\": 45,\n    \"sex\": \"Male\",\n    \"height_cm\": 175.5,\n    \"weight_kg\": 82.0,\n    \"bmi\": 26.6,\n    \"systolic_bp\": 135.0,\n    \"diastolic_bp\": 85.0,\n    \"glucose_mg_dl\": 110.0,\n    \"cholesterol_mg_dl\": 210.0,\n    \"resting_heart_rate\": 74.0,\n    \"physical_activity\": \"Moderate\",\n    \"smoking\": 0,\n    \"family_history_diabetes\": 1,\n    \"family_history_heart_disease\": 0,\n    \"frequent_urination\": 1,\n    \"excessive_thirst\": 1\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/predictions/predict/all", "host": ["{{baseUrl}}"], "path": ["api", "predictions", "predict", "all"] }
          }
        }
      ]
    },
    {
      "name": "go-service",
      "item": [
        {
          "name": "Go Microservice Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{goUrl}}/healthz", "host": ["{{goUrl}}"], "path": ["healthz"] }
          }
        },
        {
          "name": "Download PDF Report (Go gRPC)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/pdf" }],
            "url": { "raw": "{{baseUrl}}/api/predictions/{{predictionId}}/report", "host": ["{{baseUrl}}"], "path": ["api", "predictions", "{{predictionId}}", "report"] }
          }
        }
      ]
    },
    {
      "name": "Infrastructure & Observability",
      "item": [
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
          }
        },
        {
          "name": "Eureka Registry",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{eurekaUrl}}/eureka/apps", "host": ["{{eurekaUrl}}"], "path": ["eureka", "apps"] }
          }
        },
        {
          "name": "Admin Server Instances",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{adminUrl}}/instances", "host": ["{{adminUrl}}"], "path": ["instances"] }
          }
        },
        {
          "name": "Prometheus Scrape Targets",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "http://127.0.0.1:9091/api/v1/targets", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "9091", "path": ["api", "v1", "targets"] }
          }
        },
        {
          "name": "Grafana Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "http://127.0.0.1:3000/api/health", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "3000", "path": ["api", "health"] }
          }
        },
        {
          "name": "DB Exporter - PostgreSQL Metrics & Lag",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "http://127.0.0.1:9187/metrics", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "9187", "path": ["metrics"] }
          }
        },
        {
          "name": "DB Exporter - MariaDB Metrics & Lag",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "http://127.0.0.1:9104/metrics", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "9104", "path": ["metrics"] }
          }
        },
        {
          "name": "DB Exporter - MongoDB Replica Set Metrics & Lag",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "http://127.0.0.1:9216/metrics", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "9216", "path": ["metrics"] }
          }
        }
      ]
    }
  ]
}
