{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "notification.requested.v1",
  "title": "notification.requested v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "schemaVersion", "occurredAt", "type", "toEmail", "subject", "body"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "type": { "enum": ["PASSWORD_RESET", "VERIFICATION_RESEND", "GENERIC"] },
    "toEmail": { "type": "string", "format": "email" },
    "toName": { "type": "string" },
    "subject": { "type": "string" },
    "body": { "type": "string" }
  }
}
