# ==============================================================================
# SMART HEALTHCARE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. SPRING CLOUD CONFIG SERVER
# ------------------------------------------------------------------------------
# Active profile: 'native' (local directory) or 'git' (remote GitHub repository)
SPRING_PROFILES_ACTIVE=native

# Basic Auth password for microservices connecting to Config Server
CONFIG_SERVER_PASSWORD=dev-config-pass

# GitHub Personal Access Token with 'repo' scope (only if SPRING_PROFILES_ACTIVE=git)
CONFIG_GIT_TOKEN=

# ------------------------------------------------------------------------------
# 2. OAUTH2 & SOCIAL LOGIN SECRETS (auth-service)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ------------------------------------------------------------------------------
# 3. SERVICE-TO-SERVICE & BFF SECURITY
# ------------------------------------------------------------------------------
BFF_CLIENT_SECRET=change-me-bff-secret

# ------------------------------------------------------------------------------
# 4. DATABASE CREDENTIALS
# ------------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres
AUTH_DB_HOST=localhost
AUTH_DB_PASSWORD=change-me-auth-db
PROFILE_DB_PASSWORD=change-me-profile-db
PREDICTION_DB_PASSWORD=change-me-prediction-db
MARIADB_ROOT_PASSWORD=change-me-mariadb

# ------------------------------------------------------------------------------
# 5. CACHE & MESSAGE BROKER
# ------------------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
